{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit correspondre au nom du Worker dans le tableau de bord Cloudflare
  "name": "baba-hotel-clients",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Paiement en ligne (Paytweak) — secrets à définir avec `wrangler secret put`,
  // JAMAIS dans ce fichier ni dans le code (dépôt public) :
  //   wrangler secret put PAYTWEAK_PUBLIC         (jeton public)
  //   wrangler secret put PAYTWEAK_SECRET         (jeton secret / TOKEN)
  //   wrangler secret put PAYTWEAK_WEBHOOK_SECRET (jeton aléatoire dans l'URL du webhook)
  //   wrangler secret put PAYTWEAK_BASE           (optionnel : bascule sandbox, ex. https://api.paytweak.dev/v1/)
  // Tant que PAYTWEAK_PUBLIC/SECRET sont absents, l'app garde son comportement
  // actuel (minibar / départ tardif sans paiement, pas de petit-déj à la carte).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baba-hotel-clients",
      "database_id": "c08a7685-dadd-4e7b-a8df-7b6b01f61f28",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
