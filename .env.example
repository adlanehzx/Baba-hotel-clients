# Base PostgreSQL (Neon, Supabase, Vercel Postgres…). Sur Neon, prendre l'URL "pooled".
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Mot de passe de l'écran réception
RECEPTION_PASSWORD="choisir-un-mot-de-passe-solide"

# Clé de signature des sessions (32 caractères minimum). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Adresse publique du site, utilisée dans les QR codes (sans / final)
PUBLIC_BASE_URL="https://baba-hotel-clients.vercel.app"
