# Seules les deux premières variables sont obligatoires.

# Base PostgreSQL. Sur Supabase : Connect > "Transaction pooler" (port 6543).
DATABASE_URL="postgresql://postgres.xxxx:MOT-DE-PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Mot de passe de l'écran réception
RECEPTION_PASSWORD="choisir-un-mot-de-passe-solide"

# Facultatif : clé de signature des sessions (32 caractères min.).
# Par défaut, elle est dérivée de DATABASE_URL.
# SESSION_SECRET=""

# Facultatif : adresse publique utilisée dans les QR codes.
# Sur Vercel, l'adresse de production du projet est utilisée automatiquement.
# PUBLIC_BASE_URL="https://hotel.example.com"
